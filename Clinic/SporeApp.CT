  push eax
  push ebx
{$try}
  mov ebx,[$process+12DDA8C]
  test ebx,ebx
  je restoreFlags
  cmp [ebx+1C],eax
  jne restoreFlags
  cmp eax,00F00000 // ID of the player empire
  jl restoreFlags
  cmp eax,4F000000 // ID of the player empire
  jg restoreFlags
  cmp ebx,00F00000
  jl restoreFlags
  cmp ebx,4F000000
  jg restoreFlags
  mov eax,[$process+12DDA8C]
  test eax,eax
  je restoreFlags
  cmp [eax+1C],ecx
  jne restoreFlags
  cmp ecx,00F00000 // ID of the player empire
  jl restoreFlags
  cmp ecx,4F000000 // ID of the player empire
