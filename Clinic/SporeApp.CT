          <Description>"AI Defender Spaceships, More spaceships defending the player's colonies, Auto-Conquest, Fleet from own empire, and Make player empire spaceships appear randomly flying on the star system"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(INJECT,$process,A1 8C DA ?? 0? 8B 40 18) // should be unique
