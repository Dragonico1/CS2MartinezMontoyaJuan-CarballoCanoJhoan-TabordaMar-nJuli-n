  jne restoreFlags
  cmp esi,00F00000
  jl restoreFlags
  cmp esi,4F000000
  jg restoreFlags
  cmp edi,[$process+127EB20]
  jne restoreFlags
  cmp edi,00F00000
  jl restoreFlags
  cmp edi,4F000000
  jg restoreFlags
  mov eax,[$process+12DDA8C]
  test eax,eax
  je restoreFlags
  cmp [eax+1C],ebp
  jne restoreFlags
  cmp ebp,00F00000 // ID of the player empire
  jl restoreFlags
  cmp ebp,4F000000 // ID of the player empire
  jg restoreFlags
  cmp esp,000F0000
  jl restoreFlags
  cmp esp,0F000000
  jg restoreFlags
  pop eax
  add eax,1 // ID of the player empire // Or: mov ebp,00000000/mov ebp,FFFFFFFF/mov ebp,-1
  push eax

{$except}
restoreFlags:
  pop ebx
  pop eax

